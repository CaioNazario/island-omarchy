{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "useDefineForClassFields": false,
    "outDir": "dist/caionazario.island/core",
    "rootDir": "src/core",
    "declaration": false,
    "sourceMap": false,
    "types": []
  },
  "include": ["src/core"],
  "exclude": ["src/core/**/*.test.ts"]
}
